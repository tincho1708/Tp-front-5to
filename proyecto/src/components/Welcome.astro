---
import fondo from '../assets/background.svg';
---

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

<div id="contenedor">
  <img id="fondo" src={fondo.src} alt="" fetchpriority="high" />
  <div id="capa"></div>

  <button id="boton-tema" title="Cambiar modo de color">
    <span id="icono-tema">☀️</span>
  </button>

  <main>

    <!-- PANTALLA 1: INICIO -->
    <section id="inicio">

      <div class="insignia">
        <span class="punto-insignia"></span>
        Sistema activo
      </div>

      <h1 id="titulo">Panel de<br/><span class="titulo-suave">Estaciones</span></h1>

      <p class="descripcion">
        Monitoreo y gestión de las computadoras del aula.<br/>
        Consultá el estado, hardware y usuario de cada equipo en tiempo real.
      </p>

      <div class="tarjetas-info">
        <div class="tarjeta-info">
          <span class="icono-info">🖥️</span>
          <span class="etiqueta-info">3 estaciones</span>
        </div>
        <div class="tarjeta-info">
          <span class="icono-info">📡</span>
          <span class="etiqueta-info">Red local</span>
        </div>
        <div class="tarjeta-info">
          <span class="icono-info">⚡</span>
          <span class="etiqueta-info">Tiempo real</span>
        </div>
      </div>

      <div class="separador"></div>

      <p class="etiqueta-form">Para continuar, ingresá tu nombre</p>
      <div class="grupo-form">
        <input type="text" id="nombre" placeholder="Tu nombre">
        <button id="entrar">Entrar →</button>
      </div>

    </section>


    <!-- PANTALLA 2: DASHBOARD -->
    <section id="panel">

      <div class="panel-cabecera">
        <div>
          <p class="panel-subtitulo">Panel de estaciones</p>
          <h1 id="saludo"></h1>
        </div>
        <div class="panel-estado">
          <span class="estado-item"><span class="punto-estado encendido"></span>2 online</span>
          <span class="estado-item"><span class="punto-estado apagado"></span>1 offline</span>
        </div>
      </div>

      <p class="panel-descripcion">
        Hacé clic en una estación para ver su información de hardware y estado detallado.
      </p>


      <!-- GRILLA DE PCs -->
      <div id="grilla-pcs">

        <!-- PC 1 -->
        <div class="caja" data-pc="1">
          <div class="caja-tarjeta">
            <div class="tarjeta-cabecera">
              <div class="tarjeta-fila-titulo">
                <span class="nombre-pc">PC 1 (LA MEJOR)</span>
                <span class="estado-pastilla encendido">● Online</span>
              </div>
              <div class="tarjeta-subtitulo">Sala principal · Puesto A</div>
            </div>
            <div class="imagen-placeholder">
              <svg viewBox="0 0 72 58" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="3" y="2" width="66" height="40" rx="5" stroke="currentColor" stroke-width="2"/>
                <rect x="8" y="7" width="56" height="30" rx="2" fill="currentColor" fill-opacity="0.07"/>
                <line x1="25" y1="42" x2="47" y2="42" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                <rect x="16" y="42" width="40" height="6" rx="3" stroke="currentColor" stroke-width="1.5"/>
                <line x1="14" y1="17" x2="32" y2="17" stroke="currentColor" stroke-width="1.3" stroke-dasharray="3 3" stroke-linecap="round"/>
                <line x1="14" y1="24" x2="58" y2="24" stroke="currentColor" stroke-width="1.3" stroke-dasharray="3 3" stroke-linecap="round"/>
                <line x1="14" y1="31" x2="44" y2="31" stroke="currentColor" stroke-width="1.3" stroke-dasharray="3 3" stroke-linecap="round"/>
              </svg>
            </div>
            <div class="especificaciones">
              <div class="fila-spec"><span class="clave-spec">CPU</span><span class="valor-spec">Intel Core i7</span></div>
              <div class="fila-spec"><span class="clave-spec">RAM</span><span class="valor-spec">32 GB</span></div>
              <div class="fila-spec"><span class="clave-spec">GPU</span><span class="valor-spec">RTX 4070</span></div>
            </div>
            <div class="tarjeta-pie">
              <span class="usuario-pie">👤 admin</span>
              <span class="ver-mas">Ver más ↓</span>
            </div>
          </div>
          <div class="desplegable">
            <div class="titulo-seccion-drop">Especificaciones completas</div>
            <div class="fila-drop"><span>Procesador</span><span>Intel Core i7-12700K</span></div>
            <div class="fila-drop"><span>Memoria RAM</span><span>32 GB DDR5 5200 MHz</span></div>
            <div class="fila-drop"><span>Tarjeta gráfica</span><span>NVIDIA RTX 4070 12 GB</span></div>
            <div class="fila-drop"><span>Almacenamiento</span><span>1 TB NVMe SSD</span></div>
            <div class="fila-drop"><span>Sistema operativo</span><span>Windows 11 Pro</span></div>
            <div class="fila-drop"><span>Usuario activo</span><span>IVO</span></div>
            <div class="fila-drop"><span>Último acceso</span><span>Hoy, 08:14</span></div>
          </div>
        </div>

        <!-- PC 2 -->
        <div class="caja" data-pc="2">
          <div class="caja-tarjeta">
            <div class="tarjeta-cabecera">
              <div class="tarjeta-fila-titulo">
                <span class="nombre-pc">PC 2</span>
                <span class="estado-pastilla apagado">● Offline</span>
              </div>
              <div class="tarjeta-subtitulo">Sala principal · Puesto B</div>
            </div>
            <div class="imagen-placeholder">
              <svg viewBox="0 0 72 58" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="3" y="2" width="66" height="40" rx="5" stroke="currentColor" stroke-width="2"/>
                <rect x="8" y="7" width="56" height="30" rx="2" fill="currentColor" fill-opacity="0.07"/>
                <line x1="25" y1="42" x2="47" y2="42" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                <rect x="16" y="42" width="40" height="6" rx="3" stroke="currentColor" stroke-width="1.5"/>
                <line x1="14" y1="17" x2="32" y2="17" stroke="currentColor" stroke-width="1.3" stroke-dasharray="3 3" stroke-linecap="round"/>
                <line x1="14" y1="24" x2="58" y2="24" stroke="currentColor" stroke-width="1.3" stroke-dasharray="3 3" stroke-linecap="round"/>
                <line x1="14" y1="31" x2="44" y2="31" stroke="currentColor" stroke-width="1.3" stroke-dasharray="3 3" stroke-linecap="round"/>
              </svg>
            </div>
            <div class="especificaciones">
              <div class="fila-spec"><span class="clave-spec">CPU</span><span class="valor-spec">Ryzen 9 5900X</span></div>
              <div class="fila-spec"><span class="clave-spec">RAM</span><span class="valor-spec">16 GB</span></div>
              <div class="fila-spec"><span class="clave-spec">GPU</span><span class="valor-spec">RX 6800 XT</span></div>
            </div>
            <div class="tarjeta-pie">
              <span class="usuario-pie">👤 dev01</span>
              <span class="ver-mas">Ver más ↓</span>
            </div>
          </div>
          <div class="desplegable">
            <div class="titulo-seccion-drop">Especificaciones completas</div>
            <div class="fila-drop"><span>Procesador</span><span>AMD Ryzen 9 5900X</span></div>
            <div class="fila-drop"><span>Memoria RAM</span><span>16 GB DDR4 3600 MHz</span></div>
            <div class="fila-drop"><span>Tarjeta gráfica</span><span>AMD RX 6800 XT 16 GB</span></div>
            <div class="fila-drop"><span>Almacenamiento</span><span>512 GB SSD</span></div>
            <div class="fila-drop"><span>Sistema operativo</span><span>Ubuntu 22.04 LTS</span></div>
            <div class="fila-drop"><span>Usuario activo</span><span>IVO</span></div>
            <div class="fila-drop"><span>Último acceso</span><span>Ayer, 17:40</span></div>
          </div>
        </div>

        <!-- PC 3 -->
        <div class="caja" data-pc="3">
          <div class="caja-tarjeta">
            <div class="tarjeta-cabecera">
              <div class="tarjeta-fila-titulo">
                <span class="nombre-pc">PC 3</span>
                <span class="estado-pastilla encendido">● Online</span>
              </div>
              <div class="tarjeta-subtitulo">Sala principal · Puesto C</div>
            </div>
            <div class="imagen-placeholder">
              <svg viewBox="0 0 72 58" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="3" y="2" width="66" height="40" rx="5" stroke="currentColor" stroke-width="2"/>
                <rect x="8" y="7" width="56" height="30" rx="2" fill="currentColor" fill-opacity="0.07"/>
                <line x1="25" y1="42" x2="47" y2="42" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                <rect x="16" y="42" width="40" height="6" rx="3" stroke="currentColor" stroke-width="1.5"/>
                <line x1="14" y1="17" x2="32" y2="17" stroke="currentColor" stroke-width="1.3" stroke-dasharray="3 3" stroke-linecap="round"/>
                <line x1="14" y1="24" x2="58" y2="24" stroke="currentColor" stroke-width="1.3" stroke-dasharray="3 3" stroke-linecap="round"/>
                <line x1="14" y1="31" x2="44" y2="31" stroke="currentColor" stroke-width="1.3" stroke-dasharray="3 3" stroke-linecap="round"/>
              </svg>
            </div>
            <div class="especificaciones">
              <div class="fila-spec"><span class="clave-spec">CPU</span><span class="valor-spec">Intel Core i5</span></div>
              <div class="fila-spec"><span class="clave-spec">RAM</span><span class="valor-spec">64 GB</span></div>
              <div class="fila-spec"><span class="clave-spec">GPU</span><span class="valor-spec">RTX 3080</span></div>
            </div>
            <div class="tarjeta-pie">
              <span class="usuario-pie">👤 server</span>
              <span class="ver-mas">Ver más ↓</span>
            </div>
          </div>
          <div class="desplegable">
            <div class="titulo-seccion-drop">Especificaciones completas</div>
            <div class="fila-drop"><span>Procesador</span><span>Intel Core i5-13600K</span></div>
            <div class="fila-drop"><span>Memoria RAM</span><span>64 GB DDR5 4800 MHz</span></div>
            <div class="fila-drop"><span>Tarjeta gráfica</span><span>NVIDIA RTX 3080 10 GB</span></div>
            <div class="fila-drop"><span>Almacenamiento</span><span>2 TB NVMe SSD</span></div>
            <div class="fila-drop"><span>Sistema operativo</span><span>Windows 10 Pro</span></div>
            <div class="fila-drop"><span>Usuario activo</span><span>server</span></div>
            <div class="fila-drop"><span>Último acceso</span><span>Hoy, 09:02</span></div>
          </div>
        </div>

      </div>


      <!-- SEPARADOR MINADO -->
      <div class="separador-seccion">
        <div class="linea-separador"></div>
        <div class="etiqueta-seccion-wrap">
          <span class="punto-seccion"></span>
          <span class="texto-seccion">Estaciones de minado</span>
        </div>
        <div class="linea-separador"></div>
      </div>

      <p class="panel-descripcion">
        GPUs activas minando criptomonedas en la red local. Clic en una tarjeta para ver métricas detalladas.
      </p>


      <!-- ESTADÍSTICAS GLOBALES -->
      <div class="fila-stats">
        <div class="tarjeta-stat">
          <span class="etiqueta-stat">Hashrate total</span>
          <span class="valor-stat">284.6 <span class="unidad-stat">MH/s</span></span>
        </div>
        <div class="tarjeta-stat">
          <span class="etiqueta-stat">GPUs activas</span>
          <span class="valor-stat">4 <span class="unidad-stat">/ 5</span></span>
        </div>
        <div class="tarjeta-stat">
          <span class="etiqueta-stat">Consumo estimado</span>
          <span class="valor-stat">1.12 <span class="unidad-stat">kW</span></span>
        </div>
        <div class="tarjeta-stat">
          <span class="etiqueta-stat">Moneda principal</span>
          <span class="valor-stat acento">ETH</span>
        </div>
      </div>


      <!-- GRILLA DE GPUs -->
      <div id="grilla-gpus">

        <!-- GPU 1 -->
        <div class="caja gpu-caja" data-m="1">
          <div class="caja-tarjeta">
            <div class="tarjeta-cabecera">
              <div class="tarjeta-fila-titulo">
                <span class="nombre-pc">GPU-RIG 1</span>
                <span class="estado-pastilla encendido">● Minando</span>
              </div>
              <div class="tarjeta-subtitulo">Rig principal · Slot 1</div>
            </div>
            <div class="imagen-placeholder gpu-imagen">
              <svg viewBox="0 0 72 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="2" y="8" width="68" height="28" rx="4" stroke="currentColor" stroke-width="1.8"/>
                <rect x="6" y="12" width="24" height="20" rx="2" fill="currentColor" fill-opacity="0.08"/>
                <rect x="34" y="14" width="4" height="4" rx="1" fill="currentColor" fill-opacity="0.3"/>
                <rect x="40" y="14" width="4" height="4" rx="1" fill="currentColor" fill-opacity="0.3"/>
                <rect x="46" y="14" width="4" height="4" rx="1" fill="currentColor" fill-opacity="0.3"/>
                <rect x="52" y="14" width="4" height="4" rx="1" fill="currentColor" fill-opacity="0.3"/>
                <rect x="34" y="20" width="4" height="4" rx="1" fill="currentColor" fill-opacity="0.3"/>
                <rect x="40" y="20" width="4" height="4" rx="1" fill="currentColor" fill-opacity="0.3"/>
                <rect x="46" y="20" width="4" height="4" rx="1" fill="currentColor" fill-opacity="0.3"/>
                <rect x="52" y="20" width="4" height="4" rx="1" fill="currentColor" fill-opacity="0.3"/>
                <rect x="34" y="26" width="4" height="4" rx="1" fill="currentColor" fill-opacity="0.3"/>
                <rect x="40" y="26" width="4" height="4" rx="1" fill="currentColor" fill-opacity="0.3"/>
                <line x1="2" y1="36" x2="70" y2="36" stroke="currentColor" stroke-width="1" stroke-opacity="0.3"/>
                <rect x="4" y="39" width="6" height="4" rx="1" fill="currentColor" fill-opacity="0.4"/>
                <rect x="12" y="39" width="6" height="4" rx="1" fill="currentColor" fill-opacity="0.4"/>
                <rect x="20" y="39" width="6" height="4" rx="1" fill="currentColor" fill-opacity="0.4"/>
              </svg>
            </div>
            <div class="especificaciones">
              <div class="fila-spec"><span class="clave-spec">GPU</span><span class="valor-spec">RTX 4070</span></div>
              <div class="fila-spec"><span class="clave-spec">Hashrate</span><span class="valor-spec hashrate">82.4 MH/s</span></div>
              <div class="fila-spec"><span class="clave-spec">Temp</span><span class="valor-spec temp-alta">71 °C</span></div>
