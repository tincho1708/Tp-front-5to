---
import background from '../assets/background.svg';
---

<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Datatype:wght@100..900&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Trispace:wght@100..800&display=swap" rel="stylesheet">

<div id="container">
	<img id="background" src={background.src} alt="" fetchpriority="high" />

	<main>
		<section id="hero">
			<h1 id="Titulo">
				Buenos dias, ingresa tu nombre
			</h1>

			<label id="Label" for="nombre">Nombre:</label>
			<input type="text" id="nombre" placeholder="Escribe tu nombre">

			<button id="enviar">Enviar</button>
		</section>

		<section id="nuevo">
			<h1 id="saludo"></h1>

			<div id="grid">
				<div class="box"></div>
				<div class="box"></div>
				<div class="box"></div>
			</div>
		</section>
	</main>
</div>

<style>
#background {
	position: fixed;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	z-index: -1;
	filter: blur(100px);
}

#container {
	font-family: Inter, Roboto, Arial, sans-serif;
	height: 100%;
}

main {
	height: 100%;
	display: flex;
	justify-content: center;
	align-items: center;
}

#hero, #nuevo {
	display: flex;
	flex-direction: column;
	align-items: center;
	padding: 16px;
	gap: 16px;
	transition: opacity 1s ease;
}

#nuevo {
	opacity: 0;
	position: absolute;
}

/* 🔥 MÁS GRANDES */
#Titulo {
	font-family: 'Press Start 2P', cursive;
	font-size: 36px;
}

#Label {
	font-size: 36px;
	font-family: 'Datatype';
}

#nombre {
	font-size: 28px;
	padding: 12px;
	font-family: 'Trispace';
}

/* botón */
#enviar {
	padding: 14px;
	font-family: 'Press Start 2P', cursive;
	background: black;
	color: #00ff00;
	border: 2px solid #00ff00;
	cursor: pointer;
	transition: 0.3s;
}

#enviar:hover {
	background: #00ff00;
	color: black;
	transform: scale(1.05);
}

/* grid */
#grid {
	display: flex;
	gap: 20px;
	margin-top: 20px;
}

.box {
	width: 120px;
	height: 120px;
	background: linear-gradient(45deg, #00ff00, #00ccff);
	border-radius: 10px;
}

#saludo {
	font-family: 'Press Start 2P', cursive;
	font-size: 22px;
}
</style>

<script is:client>
	const input = document.getElementById("nombre");
	const boton = document.getElementById("enviar");
	const hero = document.getElementById("hero");
	const nuevo = document.getElementById("nuevo");
	const saludo = document.getElementById("saludo");

	// cargar nombre pero permitir editar SIEMPRE
	input.value = localStorage.getItem("nombre") || "";

	// enfocar automáticamente para escribir
	input.focus();

	boton.addEventListener("click", () => {
		const nombre = input.value;

		localStorage.setItem("nombre", nombre);

		hero.style.opacity = "0";

		setTimeout(() => {
			hero.style.display = "none";

			saludo.textContent = `Buenos dias, ${nombre}`;
			nuevo.style.opacity = "1";
		}, 1000);
	});
</script>