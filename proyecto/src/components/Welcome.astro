---
import background from '../assets/background.svg';
---

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

<div id="container">
	<img id="background" src={background.src} alt="" fetchpriority="high" />
	<div id="overlay"></div>

	<main>

		
		<section id="hero">

			<div class="badge">
				<span class="badge-dot"></span>
				Sistema activoo
			</div>

			<h1 id="Titulo">Panel de<br/><span class="title-accent">Estaciones</span></h1>

			<p class="descripcion">
				Monitoreo y gestión de las computadoras del aula.<br/>
				Consultá el estado, hardware y usuario de cada equipo en tiempo real.
			</p>

			<div class="info-cards">
				<div class="info-card">
					<span class="info-icon">🖥️</span>
					<span class="info-label">3 estaciones</span>
				</div>
				<div class="info-card">
					<span class="info-icon">📡</span>
					<span class="info-label">Red local</span>
				</div>
				<div class="info-card">
					<span class="info-icon">⚡</span>
					<span class="info-label">Tiempo real</span>
				</div>
			</div>

			<div class="divider"></div>

			<p class="form-label">Para continuar, ingresá tu nombre</p>
			<div class="form-group">
				<input type="text" id="nombre" placeholder="Tu nombre">
				<button id="enviar">Entrar →</button>
			</div>

		</section>

		
		
		
		<section id="nuevo">

			<div class="dash-top">
				<div>
					<p class="dash-eyebrow">Panel de estaciones</p>
					<h1 id="saludo"></h1>
				</div>
				<div class="dash-meta">
					<span class="meta-item"><span class="mdot online"></span>2 online</span>
					<span class="meta-item"><span class="mdot offline"></span>1 offline</span>
				</div>
			</div>

			<p class="dash-desc">
				Hacé clic en una estación para ver su información de hardware y estado detallado.
			</p>

			<div id="grid">

				
				<div class="box" data-pc="1">
					<div class="box-card">
						<div class="card-header">
							<div class="card-title-row">
								<span class="pc-name">PC 1 (LA MEJOR)</span>
								<span class="status-pill online">● Online</span>
							</div>
							<div class="card-sub">Sala principal · Puesto A</div>
						</div>
						<div class="image-placeholder">
							<svg viewBox="0 0 72 58" fill="none" xmlns="http://www.w3.org/2000/svg">
								<rect x="3" y="2" width="66" height="40" rx="5" stroke="currentColor" stroke-width="2"/>
								<rect x="8" y="7" width="56" height="30" rx="2" fill="currentColor" fill-opacity="0.07"/>
								<line x1="25" y1="42" x2="47" y2="42" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
								<rect x="16" y="42" width="40" height="6" rx="3" stroke="currentColor" stroke-width="1.5"/>
								<line x1="14" y1="17" x2="32" y2="17" stroke="currentColor" stroke-width="1.3" stroke-dasharray="3 3" stroke-linecap="round"/>
								<line x1="14" y1="24" x2="58" y2="24" stroke="currentColor" stroke-width="1.3" stroke-dasharray="3 3" stroke-linecap="round"/>
								<line x1="14" y1="31" x2="44" y2="31" stroke="currentColor" stroke-width="1.3" stroke-dasharray="3 3" stroke-linecap="round"/>
							</svg>
						</div>
						<div class="card-specs">
							<div class="spec-row"><span class="spec-k">CPU</span><span class="spec-v">Intel Core i7</span></div>
							<div class="spec-row"><span class="spec-k">RAM</span><span class="spec-v">32 GB</span></div>
							<div class="spec-row"><span class="spec-k">GPU</span><span class="spec-v">RTX 4070</span></div>
						</div>
						<div class="card-footer">
							<span class="footer-user">👤 admin</span>
							<span class="expand-hint">Ver más ↓</span>
						</div>
					</div>
					<div class="dropdown">
						<div class="drop-section-title">Especificaciones completas</div>
						<div class="drop-row"><span>Procesador</span><span>Intel Core i7-12700K</span></div>
						<div class="drop-row"><span>Memoria RAM</span><span>32 GB DDR5 5200 MHz</span></div>
						<div class="drop-row"><span>Tarjeta gráfica</span><span>NVIDIA RTX 4070 12 GB</span></div>
						<div class="drop-row"><span>Almacenamiento</span><span>1 TB NVMe SSD</span></div>
						<div class="drop-row"><span>Sistema operativo</span><span>Windows 11 Pro</span></div>
						<div class="drop-row"><span>Usuario activo</span><span>IVO</span></div>
						<div class="drop-row"><span>Último acceso</span><span>Hoy, 08:14</span></div>
					</div>
				</div>

			
				<div class="box" data-pc="2">
					<div class="box-card">
						<div class="card-header">
							<div class="card-title-row">
								<span class="pc-name">PC 2</span>
								<span class="status-pill offline">● Offline</span>
							</div>
							<div class="card-sub">Sala principal · Puesto B</div>
						</div>
						<div class="image-placeholder">
							<svg viewBox="0 0 72 58" fill="none" xmlns="http://www.w3.org/2000/svg">
								<rect x="3" y="2" width="66" height="40" rx="5" stroke="currentColor" stroke-width="2"/>
								<rect x="8" y="7" width="56" height="30" rx="2" fill="currentColor" fill-opacity="0.07"/>
								<line x1="25" y1="42" x2="47" y2="42" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
								<rect x="16" y="42" width="40" height="6" rx="3" stroke="currentColor" stroke-width="1.5"/>
								<line x1="14" y1="17" x2="32" y2="17" stroke="currentColor" stroke-width="1.3" stroke-dasharray="3 3" stroke-linecap="round"/>
								<line x1="14" y1="24" x2="58" y2="24" stroke="currentColor" stroke-width="1.3" stroke-dasharray="3 3" stroke-linecap="round"/>
								<line x1="14" y1="31" x2="44" y2="31" stroke="currentColor" stroke-width="1.3" stroke-dasharray="3 3" stroke-linecap="round"/>
							</svg>
						</div>
						<div class="card-specs">
							<div class="spec-row"><span class="spec-k">CPU</span><span class="spec-v">Ryzen 9 5900X</span></div>
							<div class="spec-row"><span class="spec-k">RAM</span><span class="spec-v">16 GB</span></div>
							<div class="spec-row"><span class="spec-k">GPU</span><span class="spec-v">RX 6800 XT</span></div>
						</div>
						<div class="card-footer">
							<span class="footer-user">👤 dev01</span>
							<span class="expand-hint">Ver más ↓</span>
						</div>
					</div>
					<div class="dropdown">
						<div class="drop-section-title">Especificaciones completas</div>
						<div class="drop-row"><span>Procesador</span><span>AMD Ryzen 9 5900X</span></div>
						<div class="drop-row"><span>Memoria RAM</span><span>16 GB DDR4 3600 MHz</span></div>
						<div class="drop-row"><span>Tarjeta gráfica</span><span>AMD RX 6800 XT 16 GB</span></div>
						<div class="drop-row"><span>Almacenamiento</span><span>512 GB SSD</span></div>
						<div class="drop-row"><span>Sistema operativo</span><span>Ubuntu 22.04 LTS</span></div>
						<div class="drop-row"><span>Usuario activo</span><span>IVO</span></div>
						<div class="drop-row"><span>Último acceso</span><span>Ayer, 17:40</span></div>
					</div>
				</div>

				
				<div class="box" data-pc="3">
					<div class="box-card">
						<div class="card-header">
							<div class="card-title-row">
								<span class="pc-name">PC 3</span>
								<span class="status-pill online">● Online</span>
							</div>
							<div class="card-sub">Sala principal · Puesto C</div>
						</div>
						<div class="image-placeholder">
							<svg viewBox="0 0 72 58" fill="none" xmlns="http://www.w3.org/2000/svg">
								<rect x="3" y="2" width="66" height="40" rx="5" stroke="currentColor" stroke-width="2"/>
								<rect x="8" y="7" width="56" height="30" rx="2" fill="currentColor" fill-opacity="0.07"/>
								<line x1="25" y1="42" x2="47" y2="42" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
								<rect x="16" y="42" width="40" height="6" rx="3" stroke="currentColor" stroke-width="1.5"/>
								<line x1="14" y1="17" x2="32" y2="17" stroke="currentColor" stroke-width="1.3" stroke-dasharray="3 3" stroke-linecap="round"/>
								<line x1="14" y1="24" x2="58" y2="24" stroke="currentColor" stroke-width="1.3" stroke-dasharray="3 3" stroke-linecap="round"/>
								<line x1="14" y1="31" x2="44" y2="31" stroke="currentColor" stroke-width="1.3" stroke-dasharray="3 3" stroke-linecap="round"/>
							</svg>
						</div>
						<div class="card-specs">
							<div class="spec-row"><span class="spec-k">CPU</span><span class="spec-v">Intel Core i5</span></div>
							<div class="spec-row"><span class="spec-k">RAM</span><span class="spec-v">64 GB</span></div>
							<div class="spec-row"><span class="spec-k">GPU</span><span class="spec-v">RTX 3080</span></div>
						</div>
						<div class="card-footer">
							<span class="footer-user">👤 server</span>
							<span class="expand-hint">Ver más ↓</span>
						</div>
					</div>
					<div class="dropdown">
						<div class="drop-section-title">Especificaciones completas</div>
						<div class="drop-row"><span>Procesador</span><span>Intel Core i5-13600K</span></div>
						<div class="drop-row"><span>Memoria RAM</span><span>64 GB DDR5 4800 MHz</span></div>
						<div class="drop-row"><span>Tarjeta gráfica</span><span>NVIDIA RTX 3080 10 GB</span></div>
						<div class="drop-row"><span>Almacenamiento</span><span>2 TB NVMe SSD</span></div>
						<div class="drop-row"><span>Sistema operativo</span><span>Windows 10 Pro</span></div>
						<div class="drop-row"><span>Usuario activo</span><span>server</span></div>
						<div class="drop-row"><span>Último acceso</span><span>Hoy, 09:02</span></div>
					</div>
				</div>

			</div>

			<p class="dash-footer">Panel de gestión · Sala de computación</p>

		</section>

	</main>
</div>










<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
	--bg:        #0d0f14;
	--surface:   #161920;
	--surface2:  #1e2230;
	--border:    #2a2f3d;
	--border2:   #363d52;
	--text:      #e2e4ee;
	--text-muted:#6b7390;
	--text-dim:  #3f4560;
	--accent:    #5b8dee;
	--accent-dim:#2a3d6b;
	--green:     #3fd68a;
	--green-dim: #1a3d2b;
}

#background {
	position: fixed; top: 0; left: 0;
	width: 100%; height: 100%;
	z-index: -2;
	filter: blur(80px) saturate(.6) brightness(.4);
}


#overlay {
	position: fixed; top: 0; left: 0;
	width: 100%; height: 100%;
	z-index: -1;
	background: var(--bg);
	opacity: .82;
}

#container {
	font-family: 'Inter', sans-serif;
	min-height: 100vh;
	background: var(--bg);
}

main {
	min-height: 100vh;
	display: flex;
	justify-content: center;
	align-items: center;
	padding: 40px 24px;
}


#hero {
	display: flex; flex-direction: column;
	align-items: center; gap: 20px;
	text-align: center;
	max-width: 520px; width: 100%;
	transition: opacity .7s ease;
}

.badge {
	display: flex; align-items: center; gap: 8px;
	background: var(--surface2);
	border: 1px solid var(--border2);
	border-radius: 100px;
	padding: 6px 14px;
	font-size: 13px; font-weight: 500;
	color: var(--text-muted);
}

.badge-dot {
	width: 7px; height: 7px; border-radius: 50%;
	background: var(--green);
	box-shadow: 0 0 6px var(--green);
	animation: pulse 2s ease-in-out infinite;
}

#Titulo {
	font-size: clamp(36px, 7vw, 56px);
	font-weight: 700; line-height: 1.1;
	letter-spacing: -1.5px;
	color: var(--text);
}

.title-accent {
	font-weight: 300;
	color: var(--text-muted);
}

.descripcion {
	font-size: 15px; line-height: 1.65;
	color: var(--text-muted);
	font-weight: 400;
}

.info-cards {
	display: flex; gap: 10px;
	flex-wrap: wrap; justify-content: center;
}

.info-card {
	display: flex; align-items: center; gap: 8px;
	background: var(--surface);
	border: 1px solid var(--border);
	border-radius: 10px;
	padding: 8px 14px;
	font-size: 13px; font-weight: 500;
	color: var(--text-muted);
}
.info-icon { font-size: 14px; }

.divider {
	width: 100%; height: 1px;
	background: var(--border);
}

.form-label {
	font-size: 13px;
	color: var(--text-dim);
}

.form-group { display: flex; gap: 10px; width: 100%; }

#nombre {
	flex: 1;
	font-family: 'Inter', sans-serif;
	font-size: 15px;
	padding: 11px 15px;
	border-radius: 10px;
	border: 1px solid var(--border2);
	background: var(--surface);
	color: var(--text);
	outline: none;
	transition: border-color .2s, background .2s;
}

#nombre::placeholder { color: var(--text-dim); }

#nombre:focus {
	border-color: var(--accent);
	background: var(--surface2);
}

#enviar {
	font-family: 'Inter', sans-serif;
	font-size: 15px; font-weight: 600;
	padding: 11px 22px;
	border-radius: 10px; border: none;
	background: var(--accent);
	color: #fff;
	cursor: pointer;
	transition: transform .18s, opacity .18s;
	white-space: nowrap;
}

#enviar:hover { opacity: .88; transform: scale(1.03); }

#enviar:active { transform: scale(.97); }






/*Pantalla 2*/
#nuevo {
	display: flex; flex-direction: column;
	align-items: center; gap: 24px;
	max-width: 860px; width: 100%;
	opacity: 0; position: absolute; pointer-events: none;
	transition: opacity .7s ease;
}

#nuevo.visible { opacity: 1; position: relative; pointer-events: auto; }

.dash-top {
	display: flex; justify-content: space-between;
	align-items: flex-end; width: 100%;
	flex-wrap: wrap; gap: 12px;
}

.dash-eyebrow {
	font-size: 11px; font-weight: 500;
	color: var(--text-dim);
	letter-spacing: 1.5px; text-transform: uppercase;
	margin-bottom: 5px;
}

#saludo {
	font-size: clamp(22px, 4vw, 34px);
	font-weight: 700; letter-spacing: -0.5px;
	color: var(--text);
}

.dash-meta {
	display: flex; gap: 14px; align-items: center;
	background: var(--surface);
	border: 1px solid var(--border);
	border-radius: 10px;
	padding: 8px 14px;
}

.meta-item {
	display: flex; align-items: center; gap: 6px;
	font-size: 13px; font-weight: 500;
	color: var(--text-muted);
}

.mdot { width: 7px; height: 7px; border-radius: 50%; }

.mdot.online  { background: var(--green); box-shadow: 0 0 5px var(--green); }

.mdot.offline { background: var(--border2); }

.dash-desc {
	font-size: 14px; color: var(--text-dim);
	text-align: center; line-height: 1.6;
	width: 100%;
}


#grid {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 16px; width: 100%;
	align-items: flex-start;
}

@media (max-width: 640px) { #grid { grid-template-columns: 1fr; } }


.box {
	position: relative; cursor: pointer;
	transition: transform .25s cubic-bezier(.34,1.4,.64,1);
}

.box:hover { transform: translateY(-5px); }

.box.open  { transform: translateY(-5px); z-index: 10; }

.box-card {
	background: var(--surface);
	border: 1px solid var(--border);
	border-radius: 16px;
	padding: 16px;
	display: flex; flex-direction: column; gap: 14px;
	transition: background .2s, border-color .2s;
}

.box:hover .box-card,

.box.open  .box-card {
	background: var(--surface2);
	border-color: var(--border2);
}

.card-header { display: flex; flex-direction: column; gap: 4px; }

.card-title-row {
	display: flex; justify-content: space-between; align-items: center;
}

.pc-name {
	font-family: 'JetBrains Mono', monospace;
	font-size: 15px; font-weight: 500;
	color: var(--text); letter-spacing: .5px;
}

.status-pill {
	font-size: 11px; font-weight: 600;
	padding: 3px 9px; border-radius: 100px;
}

.status-pill.online  { background: var(--green-dim); color: var(--green); }

.status-pill.offline { background: var(--surface2); color: var(--text-dim); }

.card-sub {
	font-size: 11px; color: var(--text-dim); font-weight: 400;
}

.image-placeholder {
	width: 100%; aspect-ratio: 5/3;
	border: 1px dashed var(--border2);
	border-radius: 10px;
	display: flex; align-items: center; justify-content: center;
	background: var(--bg);
	color: var(--border2);
	transition: border-color .2s, color .2s;
}


.image-placeholder svg { width: 64px; height: auto; }

.box:hover .image-placeholder,

.box.open  .image-placeholder {
	border-color: var(--accent-dim);
	color: var(--accent);
}

.card-specs {
	display: flex; flex-direction: column; gap: 5px;
	border-top: 1px solid var(--border);
	padding-top: 10px;
}

.spec-row { display: flex; justify-content: space-between; align-items: center; }

.spec-k {
	font-family: 'JetBrains Mono', monospace;
	font-size: 10px; color: var(--text-dim); font-weight: 400;
}
.spec-v { font-size: 12px; font-weight: 500; color: var(--text-muted); }

.card-footer {
	display: flex; justify-content: space-between; align-items: center;
	border-top: 1px solid var(--border);
	padding-top: 10px;
}

.footer-user { font-size: 12px; color: var(--text-dim); }

.expand-hint {
	font-size: 11px; color: var(--text-dim);
	transition: color .2s;
}

.box:hover .expand-hint,

.box.open  .expand-hint { color: var(--accent); }


.dropdown {
	position: absolute;
	top: calc(100% + 6px);
	left: 0; right: 0;
	background: var(--surface2);
	border: 1px solid var(--border2);
	border-radius: 14px;
	overflow: hidden;
	max-height: 0; opacity: 0;
	z-index: 20;
	transition: max-height .35s ease, opacity .25s ease;
}
.box.open .dropdown { max-height: 320px; opacity: 1; }

.drop-section-title {
	font-size: 10px; font-weight: 600;
	text-transform: uppercase; letter-spacing: 1.5px;
	color: var(--text-dim);
	padding: 10px 14px 6px;
	border-bottom: 1px solid var(--border);
}

.drop-row {
	display: flex; justify-content: space-between;
	align-items: center; gap: 12px;
	padding: 7px 14px;
	border-bottom: 1px solid var(--border);
}

.drop-row:last-child { border-bottom: none; }

.drop-row > span:first-child {
	font-size: 12px; font-weight: 400;
	color: var(--text-dim); white-space: nowrap;
}

.drop-row > span:last-child {
	font-family: 'JetBrains Mono', monospace;
	font-size: 11px; font-weight: 500;
	color: var(--text); text-align: right;
}


.dash-footer {
	font-size: 12px; color: var(--text-dim); margin-top: 4px;
}

@keyframes pulse {
	0%,100% { box-shadow: 0 0 4px var(--green); }
	50%      { box-shadow: 0 0 10px var(--green); }
}
</style>





<script is:inline>
	const input = document.getElementById("nombre");
	const boton = document.getElementById("enviar");
	const hero = document.getElementById("hero");
	const nuevo = document.getElementById("nuevo");
	const saludo = document.getElementById("saludo");

	
	

	
	let nombreGuardado = sessionStorage.getItem("nombre");
	if (nombreGuardado) {
		input.value = nombreGuardado;
	} else {
		input.value = "";
	}

	input.focus();

	
	input.addEventListener("keydown", function(e) {
		if (e.key === "Enter") {
			boton.click();
		}
	});

	
	boton.addEventListener("click", function() {

		let nombre = input.value.trim();

		if (nombre === "") {
			nombre = "usuario";
		}

		
		sessionStorage.setItem("nombre", nombre);

		
		hero.style.opacity = "0";
		hero.style.pointerEvents = "none";

		setTimeout(function() {

			hero.style.display = "none";

			let hora = new Date().getHours();
			let saludoTexto = "";

			if (hora < 12) {
				saludoTexto = "Buenos días";
			} 
			
			else if (hora < 19) {
				saludoTexto = "Buenas tardes";
			} 
			
			else {
				saludoTexto = "Buenas noches";
			}

			saludo.textContent = saludoTexto + ", " + nombre;

			nuevo.classList.add("visible");

		}, 700);
	});

	
	let cajas = document.querySelectorAll(".box");

	cajas.forEach(function(caja) {
		caja.addEventListener("click", function(e) {

			e.stopPropagation();

			let estaAbierta = caja.classList.contains("open");

			cajas.forEach(function(c) {
				c.classList.remove("open");
			});

			if (!estaAbierta) {
				caja.classList.add("open");
			}
		});
	});

	
	document.addEventListener("click", function() {
		cajas.forEach(function(c) {
			c.classList.remove("open");
		});
	});
</script>
