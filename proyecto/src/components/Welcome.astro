<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  /* MODO OSCURO (por defecto) */
  :root {
    --fondo:          #0d0f14;
    --superficie:     #161920;
    --superficie2:    #1e2230;
    --borde:          #2a2f3d;
    --borde2:         #363d52;
    --texto:          #e2e4ee;
    --texto-suave:    #6b7390;
    --texto-tenue:    #3f4560;
    --acento:         #5b8dee;
    --acento-tenue:   #2a3d6b;
    --verde:          #3fd68a;
    --verde-tenue:    #1a3d2b;
    --ambar:          #f0a94e;
    --ambar-tenue:    #3a2810;
    --rojo:           #f06060;
  }

  /* MODO CLARO */
  [data-tema="claro"] {
    --fondo:          #f0f2f7;
    --superficie:     #ffffff;
    --superficie2:    #e8ecf4;
    --borde:          #d0d5e8;
    --borde2:         #b8c0d8;
    --texto:          #1a1d2e;
    --texto-suave:    #4a5275;
    --texto-tenue:    #9098b8;
    --acento:         #3a6dd8;
    --acento-tenue:   #d0dcf7;
    --verde:          #1a9e5c;
    --verde-tenue:    #d0f0e2;
    --ambar:          #b87a10;
    --ambar-tenue:    #fdf0d5;
    --rojo:           #c94040;
  }

  #fondo {
    position: fixed; top: 0; left: 0;
    width: 100%; height: 100%;
    z-index: -2;
    filter: blur(80px) saturate(.6) brightness(.4);
  }

  [data-tema="claro"] #fondo {
    filter: blur(80px) saturate(.4) brightness(.9);
  }

  #capa {
    position: fixed; top: 0; left: 0;
    width: 100%; height: 100%;
    z-index: -1;
    background: var(--fondo);
    opacity: .85;
    transition: background .3s;
  }

  #contenedor {
    font-family: 'Inter', sans-serif;
    min-height: 100vh;
    background: var(--fondo);
    color: var(--texto);
    transition: background .3s, color .3s;
  }

  #boton-tema {
    position: fixed;
    top: 16px; right: 16px;
    z-index: 999;
    background: var(--superficie);
    border: 1px solid var(--borde2);
    border-radius: 50%;
    width: 40px; height: 40px;
    cursor: pointer;
    font-size: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background .2s, transform .2s, border-color .2s;
  }

  #boton-tema:hover {
    background: var(--superficie2);
    transform: scale(1.08);
  }

  main {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 40px 24px;
  }

  /* PANTALLA INICIO */
  #inicio {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
    max-width: 520px;
    width: 100%;
    transition: opacity .7s ease;
  }

  .insignia {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--superficie2);
    border: 1px solid var(--borde2);
    border-radius: 100px;
    padding: 6px 14px;
    font-size: 13px;
    font-weight: 500;
    color: var(--texto-suave);
  }

  .punto-insignia {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--verde);
    box-shadow: 0 0 6px var(--verde);
    animation: pulso 2s ease-in-out infinite;
  }

  #titulo {
    font-size: clamp(36px, 7vw, 56px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -1.5px;
    color: var(--texto);
  }

  .titulo-suave {
    font-weight: 300;
    color: var(--texto-suave);
  }

  .descripcion {
    font-size: 15px;
    line-height: 1.65;
    color: var(--texto-suave);
  }

  .tarjetas-info {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .tarjeta-info {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--superficie);
    border: 1px solid var(--borde);
    border-radius: 10px;
    padding: 8px 14px;
    font-size: 13px;
    font-weight: 500;
    color: var(--texto-suave);
  }

  .icono-info { font-size: 14px; }

  .separador {
    width: 100%;
    height: 1px;
    background: var(--borde);
  }

  .etiqueta-form {
    font-size: 13px;
    color: var(--texto-tenue);
  }

  .grupo-form { display: flex; gap: 10px; width: 100%; }

  #nombre {
    flex: 1;
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    padding: 11px 15px;
    border-radius: 10px;
    border: 1px solid var(--borde2);
    background: var(--superficie);
    color: var(--texto);
    outline: none;
    transition: border-color .2s, background .2s;
  }

  #nombre::placeholder { color: var(--texto-tenue); }

  #nombre:focus {
    border-color: var(--acento);
    background: var(--superficie2);
  }

  #entrar {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 600;
    padding: 11px 22px;
    border-radius: 10px;
    border: none;
    background: var(--acento);
    color: #fff;
    cursor: pointer;
    transition: transform .18s, opacity .18s;
    white-space: nowrap;
  }

  #entrar:hover  { opacity: .88; transform: scale(1.03); }
  #entrar:active { transform: scale(.97); }

  /* PANEL DASHBOARD */
  #panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    max-width: 900px;
    width: 100%;
    opacity: 0;
    position: absolute;
    pointer-events: none;
    transition: opacity .7s ease;
  }

  #panel.visible {
    opacity: 1;
    position: relative;
    pointer-events: auto;
  }

  .panel-cabecera {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    width: 100%;
    flex-wrap: wrap;
    gap: 12px;
  }

  .panel-subtitulo {
    font-size: 11px;
    font-weight: 500;
    color: var(--texto-tenue);
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 5px;
  }

  #saludo {
    font-size: clamp(22px, 4vw, 34px);
    font-weight: 700;
    letter-spacing: -0.5px;
    color: var(--texto);
  }

  .panel-estado {
    display: flex;
    gap: 14px;
    align-items: center;
    background: var(--superficie);
    border: 1px solid var(--borde);
    border-radius: 10px;
    padding: 8px 14px;
  }

  .estado-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 500;
    color: var(--texto-suave);
  }

  .punto-estado { width: 7px; height: 7px; border-radius: 50%; }
  .punto-estado.encendido { background: var(--verde); box-shadow: 0 0 5px var(--verde); }
  .punto-estado.apagado   { background: var(--borde2); }

  .panel-descripcion {
    font-size: 14px;
    color: var(--texto-tenue);
    text-align: center;
    line-height: 1.6;
    width: 100%;
  }

  /* GRILLAS */
  #grilla-pcs,
  #grilla-gpus {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    width: 100%;
    align-items: flex-start;
  }

  @media (max-width: 640px) {
    #grilla-pcs,
    #grilla-gpus  { grid-template-columns: 1fr; }
    .fila-stats   { grid-template-columns: repeat(2, 1fr); }
  }

  /* SEPARADOR DE SECCIÓN */
  .separador-seccion {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    margin: 8px 0 4px;
  }

  .linea-separador {
    flex: 1;
    height: 1px;
    background: var(--borde);
  }

  .etiqueta-seccion-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--superficie2);
    border: 1px solid var(--borde2);
    border-radius: 100px;
    padding: 6px 16px;
    white-space: nowrap;
  }

  .punto-seccion {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--ambar);
    box-shadow: 0 0 6px var(--ambar);
    animation: pulso-ambar 2s ease-in-out infinite;
  }

  .texto-seccion {
    font-size: 12px;
    font-weight: 600;
    color: var(--texto-suave);
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  /* STATS GLOBALES */
  .fila-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    width: 100%;
  }

  .tarjeta-stat {
    background: var(--superficie);
    border: 1px solid var(--borde);
    border-radius: 12px;
    padding: 12px 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .etiqueta-stat {
    font-size: 10px;
    font-weight: 500;
    color: var(--texto-tenue);
    letter-spacing: .8px;
    text-transform: uppercase;
  }

  .valor-stat {
    font-family: 'JetBrains Mono', monospace;
    font-size: 20px;
    font-weight: 500;
    color: var(--texto);
  }

  .unidad-stat {
    font-size: 12px;
    color: var(--texto-suave);
    font-weight: 400;
  }

  .acento { color: var(--acento) !important; }

  /* CAJAS */
  .caja {
    position: relative;
    cursor: pointer;
    transition: transform .25s cubic-bezier(.34, 1.4, .64, 1);
  }

  .caja:hover   { transform: translateY(-5px); }
  .caja.abierta { transform: translateY(-5px); z-index: 10; }

  .caja-tarjeta {
    background: var(--superficie);
    border: 1px solid var(--borde);
    border-radius: 16px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: background .2s, border-color .2s;
  }

  .caja:hover .caja-tarjeta,
  .caja.abierta .caja-tarjeta {
    background: var(--superficie2);
    border-color: var(--borde2);
  }

  .tarjeta-cabecera { display: flex; flex-direction: column; gap: 4px; }

  .tarjeta-fila-titulo {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .nombre-pc {
    font-family: 'JetBrains Mono', monospace;
    font-size: 15px;
    font-weight: 500;
    color: var(--texto);
    letter-spacing: .5px;
  }

  .estado-pastilla {
    font-size: 11px;
    font-weight: 600;
    padding: 3px 9px;
    border-radius: 100px;
  }

  .estado-pastilla.encendido { background: var(--verde-tenue); color: var(--verde); }
  .estado-pastilla.apagado   { background: var(--superficie2); color: var(--texto-tenue); }

  .tarjeta-subtitulo {
    font-size: 11px;
    color: var(--texto-tenue);
    font-weight: 400;
  }

  .imagen-placeholder {
    width: 100%;
    aspect-ratio: 5 / 3;
    border: 1px dashed var(--borde2);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--fondo);
    color: var(--borde2);
    transition: border-color .2s, color .2s;
  }

  .imagen-placeholder svg { width: 64px; height: auto; }
  .gpu-imagen svg          { width: 60px; }

  .caja:hover .imagen-placeholder,
  .caja.abierta .imagen-placeholder {
    border-color: var(--acento-tenue);
    color: var(--acento);
  }

  .especificaciones {
    display: flex;
    flex-direction: column;
    gap: 5px;
    border-top: 1px solid var(--borde);
    padding-top: 10px;
  }

  .fila-spec { display: flex; justify-content: space-between; align-items: center; }

  .clave-spec {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: var(--texto-tenue);
    font-weight: 400;
  }

  .valor-spec     { font-size: 12px; font-weight: 500; color: var(--texto-suave); }
  .valor-apagado  { color: var(--texto-tenue) !important; }

  .hashrate   { color: var(--acento) !important; font-family: 'JetBrains Mono', monospace; }
  .temp-alta  { color: var(--rojo)   !important; }
  .temp-media { color: var(--ambar)  !important; }
  .temp-baja  { color: var(--verde)  !important; }

  .tarjeta-pie {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--borde);
    padding-top: 10px;
  }

  .usuario-pie     { font-size: 12px; color: var(--texto-tenue); }
  .usuario-apagado { color: var(--texto-tenue) !important; }

  .ver-mas {
    font-size: 11px;
    color: var(--texto-tenue);
    transition: color .2s;
  }

  .caja:hover .ver-mas,
  .caja.abierta .ver-mas { color: var(--acento); }

  /* DESPLEGABLE */
  .desplegable {
    position: absolute;
    top: calc(100% + 6px);
    left: 0; right: 0;
    background: var(--superficie2);
    border: 1px solid var(--borde2);
    border-radius: 14px;
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    z-index: 20;
    transition: max-height .35s ease, opacity .25s ease;
  }

