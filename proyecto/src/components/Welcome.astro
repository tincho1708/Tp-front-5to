<script is:inline>
  var botonTema = document.getElementById("boton-tema");
  var iconoTema = document.getElementById("icono-tema");
  var contenedor = document.getElementById("contenedor");

  var temaOscuro = true;

  if (sessionStorage.getItem("tema") === "claro") {
    temaOscuro = false;
    contenedor.setAttribute("data-tema", "claro");
    iconoTema.textContent = "🌙";
  }

  botonTema.addEventListener("click", function () {
    temaOscuro = !temaOscuro;
    if (temaOscuro) {
      contenedor.removeAttribute("data-tema");
      iconoTema.textContent = "☀️";
      sessionStorage.setItem("tema", "oscuro");
    } else {
      contenedor.setAttribute("data-tema", "claro");
      iconoTema.textContent = "🌙";
      sessionStorage.setItem("tema", "claro");
    }
  });

  var inputNombre = document.getElementById("nombre");
  var botonEntrar = document.getElementById("entrar");
  var seccionInicio = document.getElementById("inicio");
  var seccionPanel = document.getElementById("panel");
  var elementoSaludo = document.getElementById("saludo");

  var nombreGuardado = sessionStorage.getItem("nombre");
  if (nombreGuardado) {
    inputNombre.value = nombreGuardado;
  } else {
    inputNombre.value = "";
  }

  inputNombre.focus();

  inputNombre.addEventListener("keydown", function (e) {
    if (e.key === "Enter") botonEntrar.click();
  });

  botonEntrar.addEventListener("click", function () {
    var nombre = inputNombre.value.trim();
    if (nombre === "") nombre = "usuario";

    sessionStorage.setItem("nombre", nombre);

    seccionInicio.style.opacity = "0";
    seccionInicio.style.pointerEvents = "none";

    setTimeout(function () {
      seccionInicio.style.display = "none";

      var hora = new Date().getHours();
      var saludo = "";

      if (hora < 12) {
        saludo = "Buenos días";
      } else if (hora < 19) {
        saludo = "Buenas tardes";
      } else {
        saludo = "Buenas noches";
      }

      elementoSaludo.textContent = saludo + ", " + nombre;
      seccionPanel.classList.add("visible");
    }, 700);
  });

  var cajas = document.querySelectorAll(".caja");

  cajas.forEach(function (caja) {
    caja.addEventListener("click", function (e) {
      e.stopPropagation();
      var estaAbierta = caja.classList.contains("abierta");

      cajas.forEach(function (c) {
        c.classList.remove("abierta");
      });

      if (!estaAbierta) {
        caja.classList.add("abierta");
      }
    });
  });

  document.addEventListener("click", function () {
    cajas.forEach(function (c) {
      c.classList.remove("abierta");
    });
  });
</script>